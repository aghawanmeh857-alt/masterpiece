// AspNetUsers is managed by ASP.NET Core Identity; included here for diagram relationships only.
Table AspNetUsers {
  Id nvarchar(450) [pk]
  Note: 'من النظام: ASP.NET Core Identity؛ مرجع للرسم فقط'
}

Table UserDocuments {
  Id int [pk]
  UserId nvarchar(450) [not null]
  DocumentType nvarchar(50)
  FileName nvarchar(250)
  FileUrl nvarchar(1000)
  FileType nvarchar(100)
  FileSizeBytes int
  UploadedAt datetime
}

Table Companies {
  Id int [pk]
  OwnerUserId nvarchar(450) [not null]
  Name nvarchar(200)
  Description nvarchar(max)
  LogoUrl nvarchar(1000)
  Email nvarchar(254)
  Phone nvarchar(30)
  WebsiteUrl nvarchar(1000)
  Address nvarchar(300)
}

Table Courses {
  Id int [pk]
  AdminUserId nvarchar(450)
  CompanyId int
  Title nvarchar(250)
  Description nvarchar(max)
  ImageUrl nvarchar(1000)
  DetailsPdfUrl nvarchar(1000)
  Price decimal(10,2)
  Category nvarchar(100)
  Skills nvarchar(1000)
  InstructorName nvarchar(150)
  Level nvarchar(50)
  DurationMinutes int
  Capacity int
  Status nvarchar(50)
  CreatedAt datetime
}

Table CourseLessons {
  Id int [pk]
  CourseId int [not null]
  Title nvarchar(250)
  Content nvarchar(max)
  VideoUrl nvarchar(1000)
  AttachmentUrl nvarchar(1000)
  SortOrder int
  DurationMinutes int
}

Table Projects {
  Id int [pk]
  OwnerUserId nvarchar(450) [not null]
  Title nvarchar(250)
  Description nvarchar(max)
  Requirements nvarchar(max)
  ImageUrl nvarchar(1000)
  DetailsPdfUrl nvarchar(1000)
  Category nvarchar(100)
  ProjectType nvarchar(50)
  Skills nvarchar(1000)
  Budget decimal(10,2)
  DurationDays int
  Deadline datetime
  Status nvarchar(50)
  CreatedAt datetime
}

Table Jobs {
  Id int [pk]
  CompanyId int [not null]
  Title nvarchar(250)
  Description nvarchar(max)
  Requirements nvarchar(max)
  ImageUrl nvarchar(1000)
  DetailsPdfUrl nvarchar(1000)
  Category nvarchar(100)
  Skills nvarchar(1000)
  WorkMode nvarchar(50)
  EmploymentType nvarchar(50)
  ExperienceLevel nvarchar(50)
  Location nvarchar(200)
  Salary decimal(10,2)
  Deadline datetime
  Status nvarchar(50)
  CreatedAt datetime
}

Table Internships {
  Id int [pk]
  CompanyId int [not null]
  Title nvarchar(250)
  Description nvarchar(max)
  Requirements nvarchar(max)
  ImageUrl nvarchar(1000)
  DetailsPdfUrl nvarchar(1000)
  Category nvarchar(100)
  Skills nvarchar(1000)
  WorkMode nvarchar(50)
  Location nvarchar(200)
  DurationMonths int
  Price decimal(10,2)
  MonthlyStipend decimal(10,2)
  Deadline datetime
  Status nvarchar(50)
  CreatedAt datetime
}

Table Events {
  Id int [pk]
  AdminUserId nvarchar(450)
  CompanyId int
  Title nvarchar(250)
  Description nvarchar(max)
  ImageUrl nvarchar(1000)
  DetailsPdfUrl nvarchar(1000)
  Category nvarchar(100)
  Location nvarchar(250)
  MeetingUrl nvarchar(1000)
  StartsAt datetime
  EndsAt datetime
  Price decimal(10,2)
  Capacity int
  Status nvarchar(50)
  CreatedAt datetime
}

Table Orders {
  Id int [pk]
  UserId nvarchar(450) [not null]
  TotalAmount decimal(10,2)
  Status nvarchar(50)
  CreatedAt datetime
}

Table OrderItems {
  Id int [pk]
  OrderId int [not null]
  CourseId int
  EventId int
  InternshipId int
  Title nvarchar(250)
  Price decimal(10,2)
  REFERENCES int
}

Table Payments {
  Id int [pk]
  OrderId int [not null]
  Amount decimal(10,2)
  PaymentMethod nvarchar(50)
  TransactionReference nvarchar(200)
  Status nvarchar(50)
  PaidAt datetime
}

Table CourseEnrollments {
  Id int [pk]
  UserId nvarchar(450) [not null]
  CourseId int [not null]
  OrderItemId int
  Status nvarchar(50)
  EnrolledAt datetime
  CompletedAt datetime
  indexes {
    (UserId, CourseId) [unique]
  }
}

Table LessonProgress {
  Id int [pk]
  EnrollmentId int [not null]
  LessonId int [not null]
  IsCompleted bit
  PlaybackSeconds int
  Notes nvarchar(max)
  UpdatedAt datetime
  indexes {
    (EnrollmentId, LessonId) [unique]
  }
}

Table ProjectApplications {
  Id int [pk]
  ProjectId int [not null]
  UserId nvarchar(450) [not null]
  FullName nvarchar(150)
  Email nvarchar(254)
  Phone nvarchar(30)
  CoverLetter nvarchar(max)
  Experience nvarchar(max)
  PortfolioUrl nvarchar(1000)
  ResumeUrl nvarchar(1000)
  ProposedAmount decimal(10,2)
  Status nvarchar(50)
  ReviewedByUserId nvarchar(450)
  ReviewedAt datetime
  AppliedAt datetime
  indexes {
    (UserId, ProjectId) [unique]
  }
}

Table JobApplications {
  Id int [pk]
  JobId int [not null]
  UserId nvarchar(450) [not null]
  FullName nvarchar(150)
  Email nvarchar(254)
  Phone nvarchar(30)
  Location nvarchar(200)
  ExperienceYears decimal(4,1)
  CoverLetter nvarchar(max)
  PortfolioUrl nvarchar(1000)
  ResumeUrl nvarchar(1000)
  Status nvarchar(50)
  ReviewedByUserId nvarchar(450)
  ReviewedAt datetime
  AppliedAt datetime
  indexes {
    (UserId, JobId) [unique]
  }
}

Table InternshipApplications {
  Id int [pk]
  InternshipId int [not null]
  UserId nvarchar(450) [not null]
  OrderItemId int
  FullName nvarchar(150)
  Email nvarchar(254)
  Phone nvarchar(30)
  CoverLetter nvarchar(max)
  Experience nvarchar(max)
  PortfolioUrl nvarchar(1000)
  ResumeUrl nvarchar(1000)
  Status nvarchar(50)
  ReviewedByUserId nvarchar(450)
  ReviewedAt datetime
  AppliedAt datetime
  REFERENCES int
  indexes {
    (UserId, InternshipId) [unique]
  }
}

Table Registrations {
  Id int [pk]
  UserId nvarchar(450) [not null]
  EventId int [not null]
  OrderItemId int
  Status nvarchar(50)
  RegisteredAt datetime
  indexes {
    (UserId, EventId) [unique]
  }
}

Table CartItems {
  Id int [pk]
  UserId nvarchar(450) [not null]
  CourseId int
  EventId int
  InternshipId int
  AddedAt datetime
  REFERENCES int
}

Table Favorites {
  Id int [pk]
  UserId nvarchar(450) [not null]
  CourseId int
  ProjectId int
  JobId int
  InternshipId int
  EventId int
  AddedAt datetime
  REFERENCES int
}

Table Conversations {
  Id int [pk]
  FirstUserId nvarchar(450) [not null]
  SecondUserId nvarchar(450) [not null]
  ProjectId int
  CreatedAt datetime
}

Table Messages {
  Id int [pk]
  ConversationId int [not null]
  SenderUserId nvarchar(450) [not null]
  Body nvarchar(max)
  AttachmentUrl nvarchar(1000)
  MessageType nvarchar(50)
  CallStatus nvarchar(50)
  CallRoomUrl nvarchar(1000)
  CallDurationSeconds int
  SentAt datetime
  ReadAt datetime
}

Table Follows {
  Id int [pk]
  FollowerUserId nvarchar(450) [not null]
  FollowedUserId nvarchar(450) [not null]
  CreatedAt datetime
  indexes {
    (FollowerUserId, FollowedUserId) [unique]
  }
}

Table UserActivities {
  Id int [pk]
  UserId nvarchar(450) [not null]
  ActorUserId nvarchar(450)
  ActivityType nvarchar(50)
  Title nvarchar(250)
  Description nvarchar(max)
  PreviousStatus nvarchar(50)
  NewStatus nvarchar(50)
  ProjectId int
  JobId int
  InternshipId int
  CourseId int
  EventId int
  LessonId int
  ProjectApplicationId int
  JobApplicationId int
  InternshipApplicationId int
  EnrollmentId int
  RegistrationId int
  OrderId int
  ConversationId int
  CreatedAt datetime
  REFERENCES int
  REFERENCES int
}

